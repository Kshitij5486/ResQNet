# ResQNet Production Environment Variables
# Copy this to .env and fill in real values before deploying

# Database
POSTGRES_DB=emergency_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# JWT
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_256_BIT_KEY

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# AI Service
AI_SERVICE_URL=http://ai-service:8084